\newlabel{fig:angle_convergence}{{4}{12}{Relative $L^2$ error of the CBED diffraction pattern versus the KG~ODE ground truth (128~sl/cell) as a function of probe convergence semi-angle for Au~[110] at 200~keV (32~sl/cell for test methods). The angular spectrum method tracks the WPM and KG~FWD accuracy throughout}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces CBED patterns for Au~[110] at 200~keV at selected convergence semi-angles (5, 20, 50, 100~mrad). Columns: KG~ODE ground truth, Fresnel MS, Angular Spectrum MS, WPM, KG~FWD Lanczos. The angular spectrum patterns are visually indistinguishable from the WPM and KG references across all tested semi-angles.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:cbed_patterns}{{5}{12}{CBED patterns for Au~[110] at 200~keV at selected convergence semi-angles (5, 20, 50, 100~mrad). Columns: KG~ODE ground truth, Fresnel MS, Angular Spectrum MS, WPM, KG~FWD Lanczos. The angular spectrum patterns are visually indistinguishable from the WPM and KG references across all tested semi-angles}{figure.5}{}}
