\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Amplitude of the central $[0,0]$ and high-angle $[0,28]$ (135~mrad) diffracted beams as a function of crystal thickness for Au~[100] at 300~keV, recreating figure~3 of \cite  {RotherScheerschmidt2009}. The angular spectrum MS (ASMS) closely tracks the WPM and KG ground truth, while Fresnel MS (FMS) diverges at high angles.}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:au_beam_amplitudes}{{2}{11}{Amplitude of the central $[0,0]$ and high-angle $[0,28]$ (135~mrad) diffracted beams as a function of crystal thickness for Au~[100] at 300~keV, recreating figure~3 of \cite {RotherScheerschmidt2009}. The angular spectrum MS (ASMS) closely tracks the WPM and KG ground truth, while Fresnel MS (FMS) diverges at high angles}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Z-sampling convergence for Au~[110] at 200~keV (${\sim }100$ unit cells). Left: relative $L^2$ error of the diffraction pattern vs.\ the KG~ODE ground truth (128~sl/cell). Right: wall-clock runtime. All methods converge at a similar rate; the more expensive WPM and KG solvers offer no z-sampling advantage.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:z_convergence}{{3}{11}{Z-sampling convergence for Au~[110] at 200~keV (${\sim }100$ unit cells). Left: relative $L^2$ error of the diffraction pattern vs.\ the KG~ODE ground truth (128~sl/cell). Right: wall-clock runtime. All methods converge at a similar rate; the more expensive WPM and KG solvers offer no z-sampling advantage}{figure.3}{}}
