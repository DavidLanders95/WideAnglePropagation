@article{chen_accurate_1997,
	title = {{Accurate} multislice theory for elastic electron scattering in transmission electron microscopy},
	volume = {70},
	issn = {0304-3991},
	url = {https://www.sciencedirect.com/science/article/pii/S0304399197000715},
	doi = {10.1016/S0304-3991(97)00071-5},
	abstract = {{Combining} the concept of the slice-transmission-operator matrix with the transfer matrix technique, the complete {Schr}ödinger equation for elastic electron scattering in solids is rigorously solved within the framework of the multislice scheme. {This} new approach extends the range in which the multislice theory is accurate. {It} is shown that the multislice theory can in principle be as accurate as the {Bloch} wave theory and the {Green} function theory in all cases of elastic electron scattering. {It} is pointed out that in some cases such as the calculation of high-order {Laue} zone ({HOLZ}) reflections, more accurate corrections should be made for the conventional high-energy approximation and therefore the conventional multislice method ({CMS}). {A} new multislice formula is developed for calculating the transmitted wave. {This} formula takes back-scattering effects into account and may therefore be accurate for large beam tilt. {It} is also shown that the new multislice approach keeps all the advantages of the {CMS} with respect to the {Bloch} wave method.},
	pages = {29--44},
	number = {1},
	journaltitle = {{Ultramicroscopy}},
	shortjournal = {{Ultramicroscopy}},
	author = {{Chen}, {Jiang} {Hua} and {Van} {Dyck}, {Dirk}},
	urldate = {2026-05-28},
	date = {1997-12-01},
	keywords = {{Back}-scattering effects, {HOLZ} effects, {Multislice} theory},
	file = {ScienceDirect Snapshot:C\:\\Users\\dl277493\\Zotero\\storage\\J5M4V3SJ\\S0304399197000715.html:text/html},
}

@article{xing_virtual_2021,
	title = {{Virtual} depth-scan multi-slice ptychography for improved three-dimensional imaging},
	volume = {29},
	issn = {1094-4087},
	url = {https://opg.optica.org/abstract.cfm?URI=oe-29-11-16214},
	doi = {10.1364/OE.422214},
	abstract = {{Multi}-slice ptychography ({MSP}) is a fast three-dimensional ptychography technology developed on the basis of conventional ptychography. {With} this method, three-dimensional imaging can be achieved without rotating the sample. {The} prototype multi-slice algorithm can only reconstruct three-dimensional samples with a limited number of slices, which greatly limits the depth range and resolution of sample imaging. {Here} we reported a virtual depth-scan scheme of {MSP} in which a thick sample is scanned virtually in the depth direction across its whole thickness range within the reconstruction process, thereby eliminating the restriction on slice number and potentially improving the depth resolution of {MSP}. {This} new approach also improves the flexibility of multi-slice ptychography. {Both} the simulation and experimental results validate the feasibility of our new approach.},
	pages = {16214},
	number = {11},
	journaltitle = {{Optics} {Express}},
	shortjournal = {{Opt}. {Express}},
	author = {{Xing}, {Zhenjiang} and {Xu}, {Zijian} and {Zhang}, {Xiangzhi} and {Chen}, {Bo} and {Guo}, {Zhi} and {Wang}, {Jian} and {Wang}, {Yong} and {Tai}, {Renzhong}},
	urldate = {2026-06-01},
	date = {2021-05-24},
	langid = {english},
	file = {Xing et al. - 2021 - Virtual depth-scan multi-slice ptychography for im.pdf:C\:\\Users\\dl277493\\Zotero\\storage\\E3EKPFSG\\Xing et al. - 2021 - Virtual depth-scan multi-slice ptychography for im.pdf:application/pdf},
}

@article{jorgensen_hard_2024,
	title = {{Hard} x-ray grazing-incidence ptychography: large field-of-view nanostructure imaging with ultra-high surface sensitivity},
	volume = {11},
	issn = {2334-2536},
	url = {https://opg.optica.org/abstract.cfm?URI=optica-11-2-197},
	doi = {10.1364/OPTICA.505478},
	shorttitle = {{Hard} x-ray grazing-incidence ptychography},
	abstract = {{The} morphology and distribution of nanoscale structures, such as
					catalytic active nanoparticles and quantum dots on surfaces, have a
					significant impact on their function. {Thus}, the capability of
					monitoring these properties during manufacturing and operation is
					crucial for the development of devices that rely on such materials. {We}
					demonstrate a technique that allows highly surface-sensitive imaging
					of nanostructures on planar surfaces over large areas. {The}
					capabilities of hard x-ray grazing-incidence ptychography combine
					aspects from imaging, reflectometry, and grazing-incidence small angle
					scattering in providing images that cover a large field of view along
					the beam direction while providing high surface sensitivity. {For}
					homogeneous samples, it yields a surface profile sensitivity better
					than 1 nm normal to the surface, with a poorer resolution in
					the sample surface plane, (i.e., along the beam and transverse
					to the beam). {Like} other surface scattering methods, this technique
					facilitates the characterization of nanostructures across
					statistically significant surface areas or volumes but with additional
					spatial information. {In} this work, we present a reconstructed test
					object spanning 4.5mm×20µm with 20 nm high topology.},
	pages = {197},
	number = {2},
	journaltitle = {{Optica}},
	shortjournal = {{Optica}},
	author = {{J}ørgensen, {P}. {S}. and {Besley}, {L}. and {Slyamov}, {A}. {M}. and {Diaz}, {A}. and {Guizar}-{Sicairos}, {M}. and {Odstr}čil, {M}. and {Holler}, {M}. and {Silvestre}, {C}. and {Chang}, {B}. and {Detlefs}, {C}. and {Andreasen}, {J}. {W}.},
	urldate = {2026-06-01},
	date = {2024-02-20},
	langid = {english},
	file = {Jørgensen et al. - 2024 - Hard x-ray grazing-incidence ptychography large f.pdf:C\:\\Users\\dl277493\\Zotero\\storage\\P59FABVZ\\Jørgensen et al. - 2024 - Hard x-ray grazing-incidence ptychography large f.pdf:application/pdf},
}

