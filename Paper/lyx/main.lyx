\end_inset

, and in much of the optics literature 
\begin_inset CommandInset citation
LatexCommand citet
after ""
before ""
key "goodman"
literal "false"

\end_inset

. The vacuum spatial frequency 
\begin_inset Formula $p_0$
\end_inset

 is therefore 
\begin_inset Formula \begin{equation}
k_0 = \frac{1}{\lambda},
\end{equation}
\end_inset

where 
\begin_inset Formula $\lambda$
\end_inset

 is the relativistic electron wavelength. This differs from the optics convention 
\begin_inset Formula $K_0=2\pi/\lambda$
\end_inset

, so that 
\begin_inset Formula $K_0=2\pi k_0$
\end_inset

.
\end_layout

\begin_layout Standard
The consequence of this convention is twofold. First, we define the Fourier transform with the phase factor 
\begin_inset Formula \begin{equation}
\mathcal F\{f(x,y)\}(q_x,q_y)
=
\int f(x,y)
\exp\left[-2\pi i(q_x x+q_y y)\right]\,dx\,dy,
\label{eq:fourier_convention}
\end{equation}
\end_inset

where 
\begin_inset Formula $(q_x,q_y)$
\end_inset

 are transverse spatial frequencies in cycles per unit length. Second, a plane wave propagating in the direction 
\begin_inset Formula $\mathbf k=(k_x,k_y,k_z)$
\end_inset

, with 
\begin_inset Formula $|\mathbf k|=k_0=1/\lambda$
\end_inset

, is written as
\end_layout

\begin_layout Standard

\begin_inset Formula \begin{equation}
\psi(\mathbf{r})
=
\exp\!\left(2\pi i\,\mathbf{k}\cdot\mathbf{r}\right)
=
\exp\!\left[2\pi i\left(k_x x+k_y y+k_z z\right)\right].
\label{eq:plane_wave_convention}
\end{equation}
\end_inset


