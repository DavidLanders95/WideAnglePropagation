\begin_layout Subsection
A Note on the Energy Eigenvalue in the Corrected Schrödinger Equation
\end_layout

\begin_layout Standard

\begin_inset CommandInset label
LatexCommand label
name "app:corrected_schrodinger_eigenvalue"

\end_inset


\end_layout

\begin_layout Standard
The relativistically corrected Schrödinger equation is commonly written as
\end_layout

\begin_layout Standard
In particular, the physical time dependence of a stationary relativistic state remains 
\begin_inset Formula \begin{equation}
\Psi(\mathbf r,t)
=
\psi(\mathbf r)
\exp\left(-\frac{iE_{\mathrm{tot}}t}{\hbar}\right).
\end{equation}
\end_inset

Thus, 
\begin_inset Formula $E_{\mathrm{tot}}$
\end_inset

 governs the temporal phase, whereas 
\begin_inset Formula $p_0^2/(2\gamma m_0)$
\end_inset

 is the eigenvalue of the equivalent stationary Schrödinger-like equation.
\end_layout

